<Page x:Class="DetMir.Pages.Page2Client"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:DetMir.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page2Client">

    <Grid>
        <Grid.Resources>
            <Style x:Key="LblRed" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.08*"/>
            <RowDefinition Height="0.08*"/>
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.3*"/>
        </Grid.RowDefinitions>

        <!-- СТРОКА 0: ФИО клиента -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="1" x:Name="clientTX"
                       Width="300" HorizontalAlignment="Left" FontSize="13"/>
            <TextBlock x:Name="rowCount" Grid.Column="2"
                       Background="Azure" FontSize="13"/>
        </Grid>

        <!-- СТРОКА 1: Заголовки -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Поиск" HorizontalAlignment="Center" Grid.Column="0"/>
            <TextBlock Text="Сортировка" HorizontalAlignment="Center" Grid.Column="1"/>
            <TextBlock Text="Фильтрация" HorizontalAlignment="Center" Grid.Column="2"/>
        </Grid>

        <!-- СТРОКА 2: Управление -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBox Name="PoiskTB" Grid.Column="0" Margin="5,0"
                     TextChanged="PoiskTB_TextChanged"/>

            <ComboBox x:Name="sortCB" Grid.Column="1" Margin="5,0"
                      SelectionChanged="sortCB_SelectionChanged">
                <ComboBoxItem>по возрастанию стоимости</ComboBoxItem>
                <ComboBoxItem>по убыванию стоимости</ComboBoxItem>
            </ComboBox>

            <ComboBox x:Name="fitCB" Grid.Column="2" Margin="5,0"
                      SelectionChanged="fitCB_SelectionChanged">
                <ComboBoxItem>Все диапазоны</ComboBoxItem>
                <ComboBoxItem>Скидка: от 0 до 10 %</ComboBoxItem>
                <ComboBoxItem>Скидка: от 11 до 14 %</ComboBoxItem>
                <ComboBoxItem>Скидка: от 15 % и более</ComboBoxItem>
            </ComboBox>
        </Grid>

        <!-- СТРОКА 3: Список карточек -->
        <ListBox Grid.Row="3" Name="ListProduct"
                 Background="Transparent" Margin="5"
                 BorderBrush="Transparent"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource LblRed}"/>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" Background="Azure"
                            Width="700" Height="170" Padding="5">
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <!-- Фото -->
                            <StackPanel Orientation="Vertical"
                                        Background="YellowGreen"
                                        Width="150" Height="150" Margin="5">
                                <TextBlock Name="StringImage" Visibility="Hidden"
                                           Text="{Binding fixImg, StringFormat=..//{0}}"/>
                                <Image Source="{Binding Text, ElementName=StringImage}"
                                       Style="{StaticResource imgSource}"/>
                            </StackPanel>

                            <!-- Информация о товаре -->
                            <StackPanel Orientation="Vertical"
                                        Width="350" Height="150" Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Наименование товара: "
                                               FontWeight="Bold"
                                               Style="{StaticResource prdctTB}" Background="{Binding}"/>
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource prdctTB}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Описание товара: "
                                               FontWeight="Bold"
                                               Style="{StaticResource prdctTB}"/>
                                    <TextBlock Text="{Binding Description}"
                                               Width="200"
                                               Style="{StaticResource prdctTB}"
                                               FontSize="13"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Производитель: "
                                               FontWeight="Bold"
                                               Style="{StaticResource prdctTB}"/>
                                    <TextBlock Text="{Binding Manufacture.Manufacture1}"
                                               Style="{StaticResource prdctTB}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Цена: "
                                               FontWeight="Bold"
                                               Style="{StaticResource prdctTB}"/>
                                    <TextBlock Text="{Binding stoimost}" TextDecorations="{Binding oldCostStyle}"
                                               Style="{StaticResource prdctTB}"/>
                                    <TextBlock Text=" рублей"
                                               Style="{StaticResource prdctTB}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Скидка -->
                            <StackPanel Orientation="Vertical"
                                        Width="100" Height="100" Margin="5">
                                <TextBlock Text="Размер скидки: "
                                           FontWeight="Bold"
                                           Style="{StaticResource prdctTB}"/>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Discount}"
                                               Style="{StaticResource prdctTB}"/>
                                    <TextBlock Text=" %"
                                               Style="{StaticResource prdctTB}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- СТРОКА 4: Таблица -->
        <DataGrid Grid.Row="4" Name="gridList"
                  IsReadOnly="True" AutoGenerateColumns="False"
                  Height="100" MaxWidth="750"
                  Margin="5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Артикул"
                                    Binding="{Binding Article}" Width="*"/>
                <DataGridTextColumn Header="Наименование"
                                    Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Стоимость"
                                    Binding="{Binding Stoimost}" Width="*"/>
                <DataGridTextColumn Header="Скидка"
                                    Binding="{Binding Discount}" Width="*"/>
                <DataGridTextColumn Header="Количество на складе"
                                    Binding="{Binding Quantity_in_stock}" Width="*"/>
                <DataGridTextColumn Header="Поставщик"
                                    Binding="{Binding Provider.Provider1}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>