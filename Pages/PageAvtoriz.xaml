<Page x:Class="DetMir.Pages.PageAvtoriz"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DetMir.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageAvtoriz">

    <Grid>
        <!--Разбитие на строки и столбцы-->
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <!--Надписи: Авторизация, Логин, Пароль-->
        <Grid Grid.Row="0" Grid.Column="1">
            <Label Content="Авторизация" HorizontalAlignment="Center"></Label>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="0">
            <Label Content="Логин" HorizontalAlignment="Right"></Label>
        </Grid>
        <Grid Grid.Row="2" Grid.Column="0">
            <Label Content="Пароль" HorizontalAlignment="Right"></Label>
        </Grid>
        <!--Текстовые поля для ввода логина и пароля-->
        <Grid Grid.Row="1" Grid.Column="1">
            <TextBox x:Name="tbLog" Width="200" Height="30"></TextBox>
        </Grid>
        <Grid Grid.Row="2" Grid.Column="1">
            <PasswordBox x:Name="PbPass" PasswordChar="*" Width="200" Height="30" />
        </Grid>
        <!--Кнопки:Войти как гость Войти и Регистрация-->
        <Grid Grid.Row="3" Grid.Column="1">
            <Button x:Name="BtnPerson" Content="Войти" Style="{StaticResource mainbtn}" Click="BtnPerson_Click"/>
        </Grid>
        <Grid Grid.Row="3" Grid.Column="2">
            <Button x:Name="BtnGuest" Content="Войти как гость" Style="{StaticResource mainbtn}" Click="BtnGuest_Click"/>
        </Grid>
        <Grid Grid.Row="3" Grid.Column="0">
            <Button x:Name="BtnReg" Content="Регистрация" Style="{StaticResource mainbtn}" Click="BtnReg_Click"/>
        </Grid>
    </Grid>
</Page>
