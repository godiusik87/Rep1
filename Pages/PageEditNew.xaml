<Page x:Class="DetMir.Pages.PageEditNew"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:DetMir.Pages"
      mc:Ignorable="d"
      d:DesignHeight="300" d:DesignWidth="800"
      Title="PageEditNew">

    <Grid>
        <ScrollViewer>
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- АРТИКУЛ -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Артикул: " Width="160" FontSize="17"/>
                    <TextBox x:Name="articleTX" Width="180" FontSize="17"/>
                </StackPanel>

                <!-- НАЗВАНИЕ -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Наименование: " Width="160" FontSize="17"/>
                    <TextBox x:Name="titleTX" Width="180" FontSize="17"/>
                </StackPanel>

                <!-- ЕДИНИЦА ИЗМЕРЕНИЯ -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Единица измерения: " Width="160" FontSize="17"/>
                    <ComboBox x:Name="typeEdIzmCB" FontSize="17"
                              SelectionChanged="EdIzmCB_SelectionChanged"
                              Style="{StaticResource mainCombo}">
                        <ComboBoxItem Content="уп." HorizontalAlignment="Left"/>
                        <ComboBoxItem Content="шт." HorizontalAlignment="Left"/>
                    </ComboBox>
                    <!-- скрытый Label для unit -->
                    <Label x:Name="Lbl" Visibility="Hidden"/>
                </StackPanel>

                <!-- СТОИМОСТЬ -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Стоимость: " Width="160" FontSize="17"/>
                    <TextBox x:Name="StoiMTX" Width="180" FontSize="17"/>
                </StackPanel>

                <!-- MAX СКИДКА -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Max скидка: " Width="160" FontSize="17"/>
                    <TextBox x:Name="MaxSkdTX" Width="180" FontSize="17"/>
                </StackPanel>

                <!-- ПРОИЗВОДИТЕЛЬ -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Производитель: " Width="160" FontSize="17"/>
                    <ComboBox x:Name="comboBox2"
                              Style="{StaticResource mainCombo}"/>
                </StackPanel>

                <!-- ПОСТАВЩИК -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Поставщик: " Width="160" FontSize="17"/>
                    <ComboBox x:Name="comboBox3"
                              Style="{StaticResource mainCombo}"/>
                </StackPanel>

                <!-- КАТЕГОРИЯ -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Категория товара: " Width="160" FontSize="17"/>
                    <ComboBox x:Name="comboBox4"
                              Style="{StaticResource mainCombo}"/>
                </StackPanel>

                <!-- СКИДКА -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Скидка: " Width="160" FontSize="17"/>
                    <TextBox x:Name="scidTX" Width="180" FontSize="17"/>
                </StackPanel>

                <!-- КОЛИЧЕСТВО НА СКЛАДЕ -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Количество на складе: " Width="160" FontSize="17"/>
                    <TextBox x:Name="colSkladTX" Width="180" FontSize="17"/>
                </StackPanel>

                <!-- ОПИСАНИЕ -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Описание: " Width="160" FontSize="17"/>
                    <TextBox x:Name="descTX" Width="180" Height="30" FontSize="17"/>
                </StackPanel>

                <!-- ИЗОБРАЖЕНИЕ -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Изображение: " Width="160" FontSize="17"/>
                    <StackPanel Orientation="Vertical">
                        <TextBox x:Name="StringImage" Visibility="Hidden"/>
                        <TextBlock x:Name="mainImgName"/>
                        <Image Source="{Binding Text, ElementName=StringImage}"
                               Style="{StaticResource imgSource}"/>
                        <Button Content="Обзор..." Click="AddIMG"/>
                    </StackPanel>
                </StackPanel>

                <!-- СОХРАНИТЬ -->
                <Button x:Name="saveAddBT"
                        Style="{StaticResource mainbtn}"
                        Content="Сохранить"
                        Click="saveAddBT_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>