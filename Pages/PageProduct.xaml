<Page x:Class="DetMir.Pages.PageProduct"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:DetMir.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageProduct">

    <Grid>
        <Grid.Resources>
            <Style x:Key="LblRed" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- поиск -->
            <RowDefinition Height="*"/>
            <!-- карточки (ListBox) -->
            <RowDefinition Height="Auto"/>
            <!-- сортировка -->
            <RowDefinition Height="150"/>
            <!-- таблица (DataGrid) -->
        </Grid.RowDefinitions>

        <!-- ПОИСК -->
        <DockPanel Grid.Row="0" Background="Azure">
            <TextBlock Text="Найти" VerticalAlignment="Center"
                       Margin="40,5,5,5" Width="50" FontSize="17"/>
            <TextBox Name="TxtSearch" Height="30" Margin="5"
                     TextChanged="TxtSearch_TextChanged"/>
        </DockPanel>

        <!-- КАРТОЧКИ ТОВАРОВ -->
        <ListBox Grid.Row="1"
                 Name="ListProduct"
                 Background="Transparent"
                 Margin="5"
                 BorderBrush="Transparent"
                 HorizontalContentAlignment="Stretch">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource LblRed}"/>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" Background="Azure"
                            Width="700" Padding="10">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Photo}"
                                   Style="{StaticResource imgSource}"/>

                            <StackPanel Orientation="Vertical" Margin="10,0,0,0">

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Наименование: "
                                               FontWeight="Bold"
                                               Style="{StaticResource prdctTB}"/>
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource prdctTB}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Описание: "
                                               FontWeight="Bold"
                                               Style="{StaticResource prdctTB}"/>
                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource prdctTB}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Производитель: "
                                               FontWeight="Bold"
                                               Style="{StaticResource prdctTB}"/>
                                    <TextBlock Text="{Binding Manufacture.Manufacture1}"
                                               Style="{StaticResource prdctTB}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Стоимость: "
                                               FontWeight="Bold"
                                               Style="{StaticResource prdctTB}"/>
                                    <TextBlock Text="{Binding Stoimost}"
                                               Style="{StaticResource prdctTB}"/>
                                    <TextBlock Text=" рублей"
                                               Style="{StaticResource prdctTB}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Скидка: "
                                               FontWeight="Bold"
                                               Style="{StaticResource prdctTB}"/>
                                    <TextBlock Text="{Binding Discount}"
                                               Style="{StaticResource prdctTB}"/>
                                    <TextBlock Text=" %"
                                               Style="{StaticResource prdctTB}"/>
                                </StackPanel>

                                <Button Name="BtnEdit"
                                        Content="Редактировать"
                                        Style="{StaticResource mainbtn}"
                                        Margin="10"
                                        Click="BtnEdit_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- СОРТИРОВКА -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5">
            <RadioButton Name="RbUp"
                         Content="По возрастанию"
                         Margin="5,5,10,5"
                         Checked="RbUp_Checked"/>
            <RadioButton Name="RbDown"
                         Content="По убыванию"
                         Margin="5,5,10,5"
                         Checked="RbDown_Checked"/>
            <Button x:Name="DelBT" Style="{StaticResource mainbtn}" Content="Удалить" Click="DelBT_Click"/>
        </StackPanel>

        <!-- ТАБЛИЦА -->
        <DataGrid Grid.Row="3"
                  Name="gridList"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  Margin="5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Артикул"
                                    Binding="{Binding Article}" Width="*"/>
                <DataGridTextColumn Header="Наименование"
                                    Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Стоимость"
                                    Binding="{Binding Stoimost}" Width="*"/>
                <DataGridTextColumn Header="Скидка"
                                    Binding="{Binding Discount}" Width="*"/>
                <DataGridTextColumn Header="Количество на складе"
                                    Binding="{Binding Quantity_in_stock}" Width="*"/>
                <DataGridTextColumn Header="Поставщик"
                                    Binding="{Binding Provider.Provider1}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Page>